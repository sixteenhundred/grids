# GRID — environment variables
# Copy to .env.local for local dev, or set these in your host (Vercel) for prod.

# --- Auth ---------------------------------------------------------------
# A long random secret. Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# --- Demo / test login --------------------------------------------------
# Override the built-in demo account credentials (works with no database).
# Set these in Vercel to use your own email + password on the deployed site.
DEMO_EMAIL=you@example.com
DEMO_PASSWORD=your-test-password
DEMO_NAME=Your Name

# --- Admin --------------------------------------------------------------
# The DEMO_EMAIL account is always an admin (sees /dashboard/admin Control
# Panel). Grant admin to additional accounts with a comma-separated list:
# ADMIN_EMAILS=ops@example.com,founder@example.com

# --- AI (Campaign live web research) ------------------------------------
# When set, the Campaign feature uses Claude + web search to research real,
# current campaigns instead of the built-in sample generator. Get a key at
# https://console.anthropic.com. Unset = deterministic sample concepts.
ANTHROPIC_API_KEY=sk-ant-...

# The app's own URL. Local: http://localhost:3000  |  Prod: your deployed URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database -----------------------------------------------------------
# Local dev (SQLite file). Use an ABSOLUTE path to avoid cwd issues:
DATABASE_URL=file:/absolute/path/to/grid/local.db

# Production (Turso / libSQL) — comment the line above and use these instead:
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token

# ════════════════════════════════════════════════════════════════════════
#  OPTIONAL integrations — all unset by default. The app boots and builds
#  without any of these; each service simply reports "unavailable" until you
#  set its keys (and install its SDK — see docs/API_KEYS.md). Placeholders
#  only — never put real values in this file.
#  Naming rule: ONLY NEXT_PUBLIC_* vars are exposed to the browser. Everything
#  else (SECRET / TOKEN / KEY / PASSWORD) is server-only.
# ════════════════════════════════════════════════════════════════════════

# --- Payments (Stripe) — needs `npm i stripe` to activate ----------------
# STRIPE_SECRET_KEY=sk_test_...                  # server-only
# STRIPE_WEBHOOK_SECRET=whsec_...                # server-only (webhook verify)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_... # client-safe (publishable)

# --- Email (Resend) — needs `npm i resend` to activate -------------------
# RESEND_API_KEY=re_...                          # server-only
# EMAIL_FROM=GRID <no-reply@yourdomain.com>      # server-only
# WAITLIST_NOTIFY_EMAIL=you@yourdomain.com       # server-only
# CAN-SPAM: a valid physical postal address shown in every commercial email.
# COMPANY_POSTAL_ADDRESS=GRID Ltd, 123 Example St, City, Country

# --- Storage (AWS S3 / Cloudflare R2) — needs `npm i @aws-sdk/client-s3` --
# S3_REGION=auto                                 # server-only
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com  # server-only
# S3_ACCESS_KEY_ID=...                           # server-only
# S3_SECRET_ACCESS_KEY=...                       # server-only
# S3_BUCKET=grid-deliverables                    # server-only

# --- Webhooks (generic HMAC verification) --------------------------------
# WEBHOOK_SIGNING_SECRET=...                     # server-only

# --- Rate-limit durable backend (optional Upstash Redis) -----------------
# UPSTASH_REDIS_REST_URL=https://...             # server-only
# UPSTASH_REDIS_REST_TOKEN=...                   # server-only
