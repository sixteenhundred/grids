# GRID — environment variables
# Copy to .env.local for local dev, or set these in your host (Vercel) for prod.
# Naming rule: ONLY NEXT_PUBLIC_* vars reach the browser. Everything else
# (KEY / SECRET / TOKEN / PASSWORD / SERVICE_ROLE) is SERVER-ONLY.
# Placeholders only — NEVER put real values in this committed file.

# ═══════════════════════════════════════════════════════════════════════
#  REQUIRED — the app fails loudly at startup without these.
# ═══════════════════════════════════════════════════════════════════════

# --- Database (Supabase Postgres) ---------------------------------------
# Direct connection string for scripts/migrations; use the IPv4 transaction
# POOLER string for serverless/prod (Vercel). SSL is required by Supabase.
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres?sslmode=require

# --- Supabase Auth + Storage --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co       # client-safe
NEXT_PUBLIC_SUPABASE_ANON_KEY=[publishable/anon key]     # client-safe (public)
SUPABASE_SERVICE_ROLE_KEY=[service-role key]             # SERVER-ONLY — full DB/storage access

# ═══════════════════════════════════════════════════════════════════════
#  RECOMMENDED / OPTIONAL — the app boots without these; each feature
#  reports "unavailable" until its keys are set.
# ═══════════════════════════════════════════════════════════════════════

# --- App ----------------------------------------------------------------
# Absolute base URL for links (e.g. the email unsubscribe URL).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated admin emails (the /dashboard/admin Control Panel).
# ADMIN_EMAILS=founder@example.com,ops@example.com

# --- AI (Campaign live web research — Anthropic) ------------------------
# Set = Campaign uses Claude + web search; unset = deterministic sample
# generator (no external call). https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...                            # SERVER-ONLY

# --- Email (Resend) — transactional waitlist mail -----------------------
# RESEND_API_KEY=re_...                                   # SERVER-ONLY
# EMAIL_FROM=GRID <no-reply@yourdomain.com>               # SERVER-ONLY
# WAITLIST_NOTIFY_EMAIL=you@yourdomain.com                # SERVER-ONLY (admin signup notify)
# CAN-SPAM: a valid physical postal address shown in every commercial email.
# COMPANY_POSTAL_ADDRESS=GRID Ltd, 123 Example St, City, Country

# --- Rate-limit + cache durable backend (Upstash Redis) -----------------
# Without these the limiter + cache are per-instance; set them for GLOBAL
# rate limits and a shared cache across instances.
# UPSTASH_REDIS_REST_URL=https://...                      # SERVER-ONLY
# UPSTASH_REDIS_REST_TOKEN=...                            # SERVER-ONLY

# --- Monitoring (Sentry) — needs `npm i @sentry/nextjs` -----------------
# SENTRY_DSN=https://...ingest.sentry.io/...              # SERVER-ONLY

# --- Cron (domain-security monitor auth) --------------------------------
# Required for the scheduled /api/cron/domain-security job. Vercel Cron sends
# this as `Authorization: Bearer <value>`. Generate: openssl rand -hex 32
# CRON_SECRET=...                                         # SERVER-ONLY

# --- Payments (Stripe) — Phase 3; needs `npm i stripe` ------------------
# STRIPE_SECRET_KEY=sk_test_...                           # SERVER-ONLY
# STRIPE_WEBHOOK_SECRET=whsec_...                         # SERVER-ONLY (signature verify)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...          # client-safe
