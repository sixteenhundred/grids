# GRID — environment variables
# Copy to .env.local for local dev, or set these in your host (Vercel) for prod.

# --- Auth ---------------------------------------------------------------
# A long random secret. Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# The app's own URL. Local: http://localhost:3000  |  Prod: your deployed URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database -----------------------------------------------------------
# Local dev (SQLite file). Use an ABSOLUTE path to avoid cwd issues:
DATABASE_URL=file:/absolute/path/to/grid/local.db

# Production (Turso / libSQL) — comment the line above and use these instead:
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token
